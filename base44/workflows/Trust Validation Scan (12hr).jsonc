{
  "name": "Trust Validation Scan (12hr)",
  "description": "Automated 12-hour trust validation scan \u2014 runs all 8 validation engines, stores immutable TrustValidationRun, updates readiness certification, notifies admins of failures.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 12,
      "interval_unit": "hours",
      "interval_anchor": "2026-06-18T16:43:53.370000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "trust_validation_scan_12hr",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "lvTrustValidationEngine",
            "args": {
              "validation_type": "FULL_PLATFORM",
              "generated_by": "scheduled_automation"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "lvTrustValidationEngine"
  }
}