{
  "name": "LV Duplicate Detection \u2014 Evidence Hash Check (6a2544cbe557c9dc463dc9f3)",
  "description": "Automatically checks for SHA-256 hash duplicates whenever new evidence is uploaded to EvidenceVault. Creates evidence_hash_duplicate alerts and flags parcels.",
