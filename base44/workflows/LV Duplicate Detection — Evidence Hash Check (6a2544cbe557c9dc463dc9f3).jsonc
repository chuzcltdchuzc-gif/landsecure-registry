      "name": "lv_duplicate_detection_evidence_hash_check_6a2544cbe557c9dc463dc9f3",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "lvDuplicateDetection",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "lvDuplicateDetection"
  }
