{
  "name": "ParcelFlag",
  "type": "object",
  "description": "Auto-generated flags on parcels requiring attention, triggered by conflict detection or manual review needs",
  "properties": {
    "flag_id": {
      "type": "string",
      "description": "Auto-generated: FLAG-EHM-000001"
    },
    "parcel_id": {
      "type": "string"
    },
    "parcel_number": {
      "type": "string"
    },
    "flag_type": {
      "type": "string",
      "enum": [
        "CONFLICTING_ATTESTATIONS",
        "BOUNDARY_CONFLICT",
        "COMMUNITY_DISPUTE",
        "TRADITIONAL_DISPUTE",
        "MANUAL_REVIEW_REQUIRED"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "default": "MEDIUM"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "ACKNOWLEDGED",
        "RESOLVED",
        "DISMISSED"
      ],
      "default": "ACTIVE"
    },
    "notes": {
      "type": "string"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_by": {
      "type": "string"
    }
  },
  "required": [
    "parcel_id",
    "flag_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "super_admin",
            "surveyor_general",
            "compliance_officer"
          ]
        }
      }
    },
    "read": {
      "user_condition": {
        "role": {
          "$in": [
            "super_admin",
            "surveyor_general",
            "compliance_officer",
            "surveyor_partner",
            "licensed_surveyor",
            "field_agent"
          ]
        }
      }
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "super_admin",
            "surveyor_general",
            "compliance_officer"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}