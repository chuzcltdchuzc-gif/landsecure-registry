{
  "name": "CommunityAttestationAudit",
  "type": "object",
  "description": "Immutable audit trail for all community attestation operations",
  "properties": {
    "audit_id": {
      "type": "string",
      "description": "Auto-generated: CAA-EHM-000001"
    },
    "user_email": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "parcel_id": {
      "type": "string"
    },
    "parcel_number": {
      "type": "string"
    },
    "attestation_id": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "CREATED",
        "UPDATED",
        "REVIEWED",
        "APPROVED",
        "REJECTED",
        "CLARIFICATION_REQUESTED",
        "CONFLICT_DETECTED",
        "CONSENSUS_RECALCULATED",
        "DELETED"
      ]
    },
    "before_state": {
      "type": "string",
      "description": "JSON snapshot before change"
    },
    "after_state": {
      "type": "string",
      "description": "JSON snapshot after change"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "ip_address": {
      "type": "string"
    },
    "device_information": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "attestation_id",
    "action"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "super_admin",
            "surveyor_general",
            "compliance_officer",
            "field_agent",
            "surveyor_partner",
            "community_validator"
          ]
        }
      }
    },
    "read": {
      "user_condition": {
        "role": {
          "$in": [
            "super_admin",
            "surveyor_general",
            "compliance_officer"
          ]
        }
      }
    },
    "update": {
      "user_condition": {
        "role": "super_admin"
      },
      "description": "Audit records are immutable \u2014 updates restricted to super_admin only for emergency corrections"
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      },
      "description": "Audit records should never be deleted \u2014 restricted to super_admin only"
    }
  }
}