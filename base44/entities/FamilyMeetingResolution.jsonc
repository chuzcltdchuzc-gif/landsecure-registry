{
  "name": "FamilyMeetingResolution",
  "type": "object",
  "properties": {
    "resolution_reference": {
      "type": "string",
      "description": "Unique resolution reference number"
    },
    "family_name": {
      "type": "string"
    },
    "family_ownership_id": {
      "type": "string",
      "description": "Linked FamilyOwnership record"
    },
    "parcel_id": {
      "type": "string"
    },
    "parcel_number": {
      "type": "string"
    },
    "inheritance_case_id": {
      "type": "string"
    },
    "meeting_date": {
      "type": "string",
      "format": "date"
    },
    "meeting_location": {
      "type": "string"
    },
    "meeting_purpose": {
      "type": "string"
    },
    "resolution_summary": {
      "type": "string"
    },
    "chairperson": {
      "type": "string"
    },
    "secretary": {
      "type": "string"
    },
    "number_of_attendees": {
      "type": "number",
      "default": 0
    },
    "meeting_minutes": {
      "type": "string",
      "description": "Full meeting minutes text"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "adopted",
        "amended",
        "withdrawn",
        "superseded"
      ],
      "default": "draft"
    },
    "version_number": {
      "type": "number",
      "default": 1
    },
    "parent_resolution_id": {
      "type": "string",
      "description": "ID of resolution this amends"
    },
    "amendment_reason": {
      "type": "string"
    },
    "withdrawal_reason": {
      "type": "string"
    },
    "minutes_url": {
      "type": "string",
      "description": "Signed meeting minutes file URL"
    },
    "attendance_sheet_url": {
      "type": "string"
    },
    "family_agreement_url": {
      "type": "string"
    },
    "evidence_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "certificate_url": {
      "type": "string",
      "description": "Generated resolution certificate URL"
    },
    "certificate_generated": {
      "type": "boolean",
      "default": false
    },
    "submitted_by": {
      "type": "string"
    },
    "submitted_by_name": {
      "type": "string"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "family_name",
    "meeting_date",
    "meeting_purpose",
    "resolution_summary",
    "chairperson"
  ]
}