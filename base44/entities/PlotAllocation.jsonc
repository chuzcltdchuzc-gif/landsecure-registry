{
  "name": "PlotAllocation",
  "type": "object",
  "properties": {
    "inheritance_case_id": {
      "type": "string"
    },
    "family_ownership_id": {
      "type": "string"
    },
    "parcel_id": {
      "type": "string"
    },
    "parcel_number": {
      "type": "string"
    },
    "beneficiary_id": {
      "type": "string"
    },
    "beneficiary_name": {
      "type": "string"
    },
    "planned_plot_number": {
      "type": "string",
      "description": "e.g. Plot A, Sub-Parcel 1A"
    },
    "area_sqm": {
      "type": "number",
      "description": "Allocated area in square metres"
    },
    "allocation_percentage": {
      "type": "number",
      "description": "Percentage of total parcel (0-100)"
    },
    "allocation_status": {
      "type": "string",
      "enum": [
        "draft",
        "confirmed",
        "disputed",
        "reallocated",
        "transferred"
      ],
      "default": "draft"
    },
    "notes": {
      "type": "string"
    },
    "allocated_by": {
      "type": "string"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "inheritance_case_id",
    "family_ownership_id",
    "parcel_id",
    "beneficiary_id",
    "planned_plot_number",
    "allocation_percentage"
  ]
}