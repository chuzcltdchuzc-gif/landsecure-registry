{
  "name": "InheritanceCase",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant identifier (LGA code). Enforces multi-tenant isolation."
    },
    "family_ownership_id": {
      "type": "string"
    },
    "parcel_id": {
      "type": "string"
    },
    "parcel_number": {
      "type": "string"
    },
    "family_name": {
      "type": "string"
    },
    "case_reference": {
      "type": "string",
      "description": "Unique case reference number"
    },
    "case_title": {
      "type": "string"
    },
    "case_type": {
      "type": "string",
      "enum": [
        "succession",
        "partition",
        "allocation",
        "transfer",
        "dispute_resolution",
        "subdivision"
      ],
      "description": "Type of inheritance case"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "surveyor_review",
        "compliance_review",
        "surveyor_general_review",
        "approved",
        "rejected",
        "withdrawn"
      ],
      "default": "draft",
      "description": "Approval workflow stage"
    },
    "initiated_by": {
      "type": "string",
      "description": "Email of initiator"
    },
    "initiated_by_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "surveyor_reviewer": {
      "type": "string"
    },
    "surveyor_review_date": {
      "type": "string",
      "format": "date-time"
    },
    "surveyor_notes": {
      "type": "string"
    },
    "compliance_reviewer": {
      "type": "string"
    },
    "compliance_review_date": {
      "type": "string",
      "format": "date-time"
    },
    "compliance_notes": {
      "type": "string"
    },
    "sg_reviewer": {
      "type": "string",
      "description": "Surveyor General reviewer"
    },
    "sg_review_date": {
      "type": "string",
      "format": "date-time"
    },
    "sg_notes": {
      "type": "string"
    },
    "final_approved_by": {
      "type": "string"
    },
    "final_approved_date": {
      "type": "string",
      "format": "date-time"
    },
    "rejection_reason": {
      "type": "string"
    },
    "rejection_stage": {
      "type": "string"
    },
    "certificate_generated": {
      "type": "boolean",
      "default": false
    },
    "certificate_url": {
      "type": "string"
    },
    "validation_warnings": {
      "type": "string",
      "description": "JSON array of validation warning strings"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "family_ownership_id",
    "parcel_id",
    "case_type",
    "initiated_by"
  ]
}