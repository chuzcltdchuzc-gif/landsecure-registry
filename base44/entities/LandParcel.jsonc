{
  "name": "LandParcel",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant identifier (LGA code, e.g. EHM-001)."
    },
    "parcel_number": {
      "type": "string",
      "description": "System-generated unique parcel ID. Format: STATE-LGA-WARD-PROPTYPE-SEQUENCE"
    },
    "title": {
      "type": "string",
      "description": "Land title or name"
    },
    "owner_name": {
      "type": "string",
      "description": "Current owner full name"
    },
    "owner_email": {
      "type": "string",
      "description": "Owner email reference"
    },
    "owner_phone": {
      "type": "string",
      "description": "Owner phone number (private)"
    },
    "owner_nin": {
      "type": "string",
      "description": "Owner National Identification Number (strictly private)"
    },
    "ownership_type": {
      "type": "string",
      "enum": [
        "individual",
        "family",
        "community",
        "government"
      ],
      "default": "individual"
    },
    "size_sqm": {
      "type": "number",
      "description": "Size in square metres"
    },
    "size_hectares": {
      "type": "number",
      "description": "Size in hectares \u2014 derived from size_sqm / 10000 when not explicitly set"
    },
    "address": {
      "type": "string",
      "description": "Physical address"
    },
    "community": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "lga": {
      "type": "string"
    },
    "ward": {
      "type": "string"
    },
    "ward_code": {
      "type": "string",
      "description": "3-letter ward code"
    },
    "property_type": {
      "type": "string",
      "enum": [
        "RES",
        "COM",
        "FRM",
        "MKT",
        "SHP",
        "STL",
        "KSK",
        "GOV",
        "INS"
      ]
    },
    "encumbrance_status": {
      "type": "string",
      "enum": [
        "none",
        "mortgage",
        "dispute",
        "lien",
        "court_order"
      ],
      "default": "none"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "boundary_coordinates": {
      "type": "string"
    },
    "parcel_boundary": {
      "type": "string",
      "description": "GeoJSON polygon string"
    },
    "boundary_area": {
      "type": "number"
    },
    "boundary_perimeter": {
      "type": "number"
    },
    "boundary_source": {
      "type": "string",
      "enum": [
        "manual_entry",
        "gps_capture",
        "survey_plan",
        "cad_import",
        "legacy_import"
      ]
    },
    "boundary_capture_date": {
      "type": "string",
      "format": "date"
    },
    "spatial_validation_status": {
      "type": "string",
      "enum": [
        "not_validated",
        "valid",
        "overlap_warning",
        "duplicate_warning",
        "invalid_geometry",
        "conflict_blocked"
      ],
      "default": "not_validated"
    },
    "spatial_conflict_notes": {
      "type": "string"
    },
    "land_use": {
      "type": "string",
      "enum": [
        "residential",
        "commercial",
        "agricultural",
        "industrial",
        "mixed_use",
        "government"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "disputed",
        "transferred",
        "approved_locked",
        "frozen",
        "archived"
      ],
      "default": "pending"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "unverified",
        "field_verified",
        "survey_verified",
        "fully_verified"
      ],
      "default": "unverified"
    },
    "survey_plan_url": {
      "type": "string"
    },
    "cad_file_url": {
      "type": "string"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "registered_by": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "approval_date": {
      "type": "string",
      "format": "date"
    },
    "registration_date": {
      "type": "string",
      "format": "date",
      "description": "Official registration date (public)"
    },
    "rejection_reason": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "import_source": {
      "type": "string"
    },
    "fraud_risk_score": {
      "type": "number"
    },
    "fraud_risk_level": {
      "type": "string",
      "enum": [
        "none",
        "low",
        "medium",
        "high"
      ],
      "default": "none"
    },
    "fraud_risk_reasons": {
      "type": "string"
    },
    "qr_code_url": {
      "type": "string"
    },
    "certificate_url": {
      "type": "string"
    },
    "verbal_consent": {
      "type": "boolean",
      "description": "Representative verbally agreed to registration"
    },
    "verbal_consent_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "verbal_consent_agent_id": {
      "type": "string",
      "description": "Email of field agent who recorded consent"
    },
    "verbal_consent_gps": {
      "type": "string",
      "description": "JSON: {lat, lng} at time of verbal consent"
    },
    "consent_audio": {
      "type": "string",
      "description": "PRIVATE \u2014 audio consent file URL (private bucket only)"
    },
    "audio_declined": {
      "type": "boolean",
      "default": false
    },
    "consent_signature": {
      "type": "string",
      "description": "PRIVATE \u2014 base64 data URL of signature/thumb image"
    },
    "sign_declined": {
      "type": "boolean",
      "default": false
    },
    "sign_declined_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sign_declined_agent_id": {
      "type": "string"
    },
    "sign_declined_gps": {
      "type": "string"
    },
    "sign_declined_notes": {
      "type": "string"
    },
    "consent_photo": {
      "type": "string",
      "description": "PRIVATE \u2014 representative photo URL (private bucket only)"
    },
    "photo_declined": {
      "type": "boolean",
      "default": false
    },
    "witness_name": {
      "type": "string"
    },
    "witness_phone": {
      "type": "string"
    },
    "witness_role": {
      "type": "string",
      "enum": [
        "family_witness",
        "community_witness",
        "village_head",
        "none"
      ]
    },
    "witness_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "witness_gps": {
      "type": "string"
    },
    "consent_strength_score": {
      "type": "number",
      "description": "0\u2013100 consent completeness score"
    },
    "consent_confidence": {
      "type": "string",
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ],
      "description": "HIGH=80-100, MEDIUM=50-79, LOW=0-49"
    },
    "community_confirmed": {
      "type": "boolean",
      "default": false
    },
    "community_confirmed_by": {
      "type": "string"
    },
    "community_confirmed_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "community_confirmation_pending": {
      "type": "boolean",
      "default": false
    },
    "consent_timeline": {
      "type": "string",
      "description": "IMMUTABLE \u2014 JSON array of consent timeline events. Append-only. Never edit or delete entries."
    },
    "registration_package_id": {
      "type": "string",
      "description": "Reference to RegistrationPackage record"
    },
    "registration_completed": {
      "type": "boolean",
      "default": false,
      "description": "Land data capture complete"
    },
    "survey_completed": {
      "type": "boolean",
      "default": false,
      "description": "Survey/GIS boundary captured"
    },
    "ownership_verified": {
      "type": "boolean",
      "default": false,
      "description": "Ownership identity confirmed"
    },
    "protected_in_registry": {
      "type": "boolean",
      "default": true,
      "description": "Parcel is protected against duplicate claims"
    },
    "certificate_release_status": {
      "type": "string",
      "enum": [
        "released",
        "held"
      ],
      "default": "held",
      "description": "Whether the digital certificate has been released"
    },
    "certificate_hold_reason": {
      "type": "string",
      "enum": [
        "payment_pending",
        "fraud_review",
        "dispute",
        "legal_hold"
      ],
      "description": "Reason certificate is held"
    },
    "certificate_released_date": {
      "type": "string",
      "format": "date-time",
      "description": "When certificate was released"
    },
    "outstanding_certificate_fee": {
      "type": "number",
      "description": "Outstanding fee before certificate can be released (\u20a6)"
    }
  },
  "required": [
    "parcel_number",
    "owner_name",
    "address"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.verification_status": "unverified",
          "user_condition": {
            "role": "field_agent"
          }
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "super_admin",
                "surveyor_general",
                "compliance_officer",
                "surveyor",
                "community_validator"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}",
          "data.status": {
            "$ne": "approved_locked"
          }
        },
        {
          "data.owner_email": "{{user.email}}",
          "data.status": {
            "$ne": "approved_locked"
          }
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "super_admin",
                "surveyor_general",
                "compliance_officer",
                "community_validator"
              ]
            }
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}