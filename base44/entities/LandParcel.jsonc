{
  "name": "LandParcel",
  "type": "object",
  "properties": {
    "parcel_number": {
      "type": "string",
      "description": "Unique parcel identifier"
    },
    "title": {
      "type": "string",
      "description": "Land title or name"
    },
    "owner_name": {
      "type": "string",
      "description": "Current owner full name"
    },
    "owner_email": {
      "type": "string",
      "description": "Owner email reference"
    },
    "size_hectares": {
      "type": "number",
      "description": "Size in hectares"
    },
    "address": {
      "type": "string",
      "description": "Physical address"
    },
    "state": {
      "type": "string",
      "description": "State/Province"
    },
    "lga": {
      "type": "string",
      "description": "Local Government Area"
    },
    "latitude": {
      "type": "number",
      "description": "GPS latitude"
    },
    "longitude": {
      "type": "number",
      "description": "GPS longitude"
    },
    "boundary_coordinates": {
      "type": "string",
      "description": "JSON string of boundary polygon coordinates"
    },
    "parcel_boundary": {
      "type": "string",
      "description": "GeoJSON polygon string for the parcel boundary"
    },
    "boundary_area": {
      "type": "number",
      "description": "Calculated boundary area in sqm"
    },
    "boundary_perimeter": {
      "type": "number",
      "description": "Calculated boundary perimeter in meters"
    },
    "boundary_source": {
      "type": "string",
      "enum": [
        "manual_entry",
        "gps_capture",
        "survey_plan",
        "cad_import",
        "legacy_import"
      ],
      "description": "How the boundary was captured"
    },
    "boundary_capture_date": {
      "type": "string",
      "format": "date"
    },
    "spatial_validation_status": {
      "type": "string",
      "enum": [
        "not_validated",
        "valid",
        "overlap_warning",
        "duplicate_warning",
        "invalid_geometry",
        "conflict_blocked"
      ],
      "default": "not_validated",
      "description": "Result of spatial validation engine"
    },
    "spatial_conflict_notes": {
      "type": "string",
      "description": "Details of any spatial conflicts found"
    },
    "land_use": {
      "type": "string",
      "enum": [
        "residential",
        "commercial",
        "agricultural",
        "industrial",
        "mixed_use",
        "government"
      ],
      "description": "Land use type"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "disputed",
        "transferred",
        "approved_locked",
        "frozen",
        "archived"
      ],
      "default": "pending",
      "description": "Registration status"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "unverified",
        "field_verified",
        "survey_verified",
        "fully_verified"
      ],
      "default": "unverified",
      "description": "Verification level"
    },
    "survey_plan_url": {
      "type": "string"
    },
    "cad_file_url": {
      "type": "string"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "registered_by": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "approval_date": {
      "type": "string",
      "format": "date"
    },
    "rejection_reason": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "import_source": {
      "type": "string",
      "description": "ImportHistory ID if imported from bulk"
    },
    "fraud_risk_score": {
      "type": "number",
      "description": "Automated fraud risk score 0-100"
    },
    "fraud_risk_level": {
      "type": "string",
      "enum": [
        "none",
        "low",
        "medium",
        "high"
      ],
      "default": "none"
    },
    "fraud_risk_reasons": {
      "type": "string",
      "description": "JSON array of risk reason strings"
    }
  },
  "required": [
    "parcel_number",
    "owner_name",
    "address"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.verification_status": "unverified",
          "user_condition": {
            "role": "field_agent"
          }
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "super_admin",
                "surveyor_general",
                "compliance_officer",
                "surveyor"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}",
          "data.status": {
            "$ne": "approved_locked"
          }
        },
        {
          "data.owner_email": "{{user.email}}",
          "data.status": {
            "$ne": "approved_locked"
          }
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "super_admin",
                "surveyor_general",
                "compliance_officer"
              ]
            }
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}