{
  "name": "UsageLedger",
  "type": "object",
  "description": "Immutable audit trail of every credit-consuming activity.",
  "properties": {
    "usage_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "parcel_id": {
      "type": "string"
    },
    "parcel_number": {
      "type": "string"
    },
    "service_id": {
      "type": "string"
    },
    "service_name": {
      "type": "string"
    },
    "service_category": {
      "type": "string"
    },
    "credits_used": {
      "type": "number",
      "default": 0
    },
    "cash_value": {
      "type": "number",
      "default": 0
    },
    "request_reference": {
      "type": "string"
    },
    "usage_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "COMPLETED",
        "PENDING",
        "REFUNDED",
        "CANCELLED"
      ],
      "default": "COMPLETED"
    }
  },
  "required": [
    "user_id",
    "service_id",
    "credits_used"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "super_admin",
            "surveyor_general",
            "compliance_officer"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}