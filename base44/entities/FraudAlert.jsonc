{
  "name": "FraudAlert",
  "type": "object",
  "properties": {
    "parcel_id": {
      "type": "string",
      "description": "Related land parcel ID"
    },
    "parcel_number": {
      "type": "string"
    },
    "flagged_by": {
      "type": "string",
      "description": "Email of user who flagged"
    },
    "flagged_by_name": {
      "type": "string"
    },
    "alert_type": {
      "type": "string",
      "enum": [
        "duplicate_registration",
        "forged_document",
        "boundary_manipulation",
        "ownership_fraud",
        "suspicious_transfer",
        "other"
      ],
      "description": "Type of fraud alert"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "description": {
      "type": "string"
    },
    "evidence_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "under_investigation",
        "escalated",
        "resolved",
        "dismissed"
      ],
      "default": "open"
    },
    "assigned_to": {
      "type": "string",
      "description": "Compliance officer assigned"
    },
    "investigation_notes": {
      "type": "string"
    },
    "resolved_by": {
      "type": "string"
    },
    "resolved_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "parcel_id",
    "alert_type",
    "description"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.assigned_to": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "super_admin",
                "compliance_officer",
                "surveyor_general"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.assigned_to": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "super_admin",
                "compliance_officer",
                "surveyor_general"
              ]
            }
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}