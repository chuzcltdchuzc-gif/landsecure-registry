{
  "name": "FamilyOwnership",
  "type": "object",
  "properties": {
    "parcel_id": {
      "type": "string",
      "description": "Reference to LandParcel ID"
    },
    "parcel_number": {
      "type": "string"
    },
    "family_name": {
      "type": "string",
      "description": "Name of the family"
    },
    "family_head": {
      "type": "string",
      "description": "Name of the family head"
    },
    "parent_name": {
      "type": "string",
      "description": "Name of the founding ancestor/parent"
    },
    "family_branch": {
      "type": "string",
      "description": "Branch name within the family (e.g. Adeola Branch)"
    },
    "generation_level": {
      "type": "number",
      "description": "Generation number from founding ancestor (1 = founding)"
    },
    "clan_name": {
      "type": "string"
    },
    "village": {
      "type": "string"
    },
    "community": {
      "type": "string"
    },
    "lga": {
      "type": "string",
      "description": "Local Government Area"
    },
    "state": {
      "type": "string"
    },
    "wife_lineage_group": {
      "type": "string",
      "description": "Wife or lineage group (e.g. Wife Group A \u2014 Mama Tunde)"
    },
    "family_representative": {
      "type": "string"
    },
    "family_lineage": {
      "type": "string",
      "enum": [
        "patrilineal",
        "matrilineal",
        "bilateral",
        "other"
      ],
      "description": "Customary lineage system"
    },
    "family_notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "in_transfer",
        "disputed",
        "archived"
      ],
      "default": "active"
    },
    "registered_by": {
      "type": "string"
    },
    "fruit_trees": {
      "type": "number",
      "default": 0
    },
    "buildings": {
      "type": "number",
      "default": 0
    },
    "boreholes": {
      "type": "number",
      "default": 0
    },
    "economic_trees": {
      "type": "number",
      "default": 0
    },
    "other_improvements": {
      "type": "string"
    }
  },
  "required": [
    "parcel_id",
    "family_name",
    "family_head"
  ]
}