{
  "name": "LandVaultParcel",
  "type": "object",
  "properties": {
    "parcel_number": {
      "type": "string",
      "description": "System-generated. Format: ASV-EHM-WARD-000001"
    },
    "lead_id": {
      "type": "string"
    },
    "community": {
      "type": "string"
    },
    "village": {
      "type": "string"
    },
    "ward": {
      "type": "string"
    },
    "lga": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "ownership_type": {
      "type": "string",
      "enum": [
        "individual",
        "family",
        "joint",
        "community",
        "trust",
        "corporate",
        "government",
        "institutional"
      ],
      "default": "individual"
    },
    "land_use": {
      "type": "string",
      "enum": [
        "residential",
        "commercial",
        "agricultural",
        "industrial",
        "mixed_use",
        "government"
      ]
    },
    "size_sqm": {
      "type": "number"
    },
    "size_hectares": {
      "type": "number"
    },
    "gps_lat": {
      "type": "number"
    },
    "gps_lng": {
      "type": "number"
    },
    "gps_accuracy_m": {
      "type": "number"
    },
    "gps_captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "gps_confidence": {
      "type": "string",
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW",
        "FAILED"
      ]
    },
    "gps_confidence_score": {
      "type": "number"
    },
    "gps_trust_status": {
      "type": "string",
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW",
        "FLAGGED"
      ]
    },
    "gps_inside_lga": {
      "type": "boolean"
    },
    "gps_spoofing_flag": {
      "type": "boolean",
      "default": false
    },
    "gps_spoofing_reason": {
      "type": "string"
    },
    "geojson_polygon": {
      "type": "string"
    },
    "boundary_notes": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "owner_phone": {
      "type": "string"
    },
    "owner_nin": {
      "type": "string",
      "description": "PRIVATE"
    },
    "family_name": {
      "type": "string"
    },
    "family_representative": {
      "type": "string"
    },
    "family_secondary_representative": {
      "type": "string",
      "description": "PHASE 4 \u2014 Secondary rep"
    },
    "founder_name": {
      "type": "string"
    },
    "inheritance_notes": {
      "type": "string"
    },
    "family_history_notes": {
      "type": "string"
    },
    "customary_ownership_notes": {
      "type": "string",
      "description": "PHASE 4 \u2014 Customary tenure notes"
    },
    "representative_name": {
      "type": "string"
    },
    "representative_role": {
      "type": "string",
      "enum": [
        "owner",
        "family_head",
        "family_representative",
        "executor",
        "administrator",
        "attorney",
        "community_trustee",
        "village_head",
        "court_appointed",
        "other"
      ]
    },
    "representative_capacity": {
      "type": "string",
      "enum": [
        "Owner",
        "Family Representative",
        "Executor",
        "Administrator",
        "Attorney",
        "Community Trustee",
        "Village Head",
        "Court Appointed Representative",
        "Other"
      ]
    },
    "relationship_to_land": {
      "type": "string"
    },
    "authority_basis": {
      "type": "string",
      "enum": [
        "Personal Ownership",
        "Family Resolution",
        "Power of Attorney",
        "Letter of Administration",
        "Probate",
        "Court Order",
        "Community Endorsement",
        "Other"
      ]
    },
    "authority_document_url": {
      "type": "string",
      "description": "PRIVATE"
    },
    "authority_confidence": {
      "type": "string",
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ],
      "description": "PHASE 5 indicator"
    },
    "ownership_confidence_score": {
      "type": "number"
    },
    "evidence_confidence_score": {
      "type": "number",
      "description": "PHASE 2 \u2014 Evidence confidence score 0-100. Auto-calculated by lvEvidenceConfidence."
    },
    "evidence_confidence_level": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "STRONG",
        "MODERATE",
        "LIMITED"
      ],
      "description": "PHASE 2 \u2014 Derived from evidence_confidence_score"
    },
    "attestation_score": {
      "type": "number",
      "description": "PRIORITY 2 \u2014 Community attestation score 0-100. Auto-calculated by lvCommunityAttestationScore."
    },
    "attestation_level": {
      "type": "string",
      "enum": [
        "DEEP",
        "STRONG",
        "MODERATE",
        "LIGHT",
        "NONE"
      ],
      "default": "NONE",
      "description": "PRIORITY 2 \u2014 Derived from attestation_score. DEEP=85+, STRONG=60-84, MODERATE=35-59, LIGHT=15-34, NONE=0-14"
    },
    "attestation_layer_count": {
      "type": "number",
      "default": 0,
      "description": "PRIORITY 2 \u2014 Number of distinct attestation layers completed"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "unverified",
        "field_verified",
        "survey_verified",
        "community_validated",
        "fully_verified"
      ],
      "default": "unverified"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "survey_assigned",
        "survey_in_progress",
        "survey_complete",
        "documentation_complete",
        "certificate_ready",
        "certificate_issued",
        "disputed",
        "archived"
      ],
      "default": "draft"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ],
      "default": "HIGH"
    },
    "risk_score": {
      "type": "number"
    },
    "risk_factors": {
      "type": "string"
    },
    "duplicate_flag": {
      "type": "boolean",
      "default": false
    },
    "duplicate_type": {
      "type": "string",
      "enum": [
        "gps_proximity",
        "boundary_overlap",
        "owner_duplicate",
        "family_duplicate",
        "survey_plan_duplicate",
        "evidence_duplicate",
        "parcel_reference_duplicate",
        "survey_reference_duplicate",
        "none"
      ],
      "default": "none"
    },
    "duplicate_notes": {
      "type": "string"
    },
    "duplicate_reviewed": {
      "type": "boolean",
      "default": false
    },
    "duplicate_reviewed_by": {
      "type": "string"
    },
    "duplicate_reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "duplicate_review_outcome": {
      "type": "string",
      "enum": [
        "confirmed_duplicate",
        "false_positive",
        "pending"
      ]
    },
    "dispute_readiness_score": {
      "type": "number",
      "description": "PHASE 8 \u2014 0-100"
    },
    "dispute_readiness_category": {
      "type": "string",
      "enum": [
        "HIGH CONFIDENCE",
        "MODERATE RISK",
        "LOW RISK"
      ]
    },
    "survey_plan_url": {
      "type": "string"
    },
    "surveyor_id": {
      "type": "string"
    },
    "surveyor_name": {
      "type": "string"
    },
    "surveyor_licence": {
      "type": "string"
    },
    "survey_date": {
      "type": "string",
      "format": "date"
    },
    "survey_status": {
      "type": "string",
      "enum": [
        "not_assigned",
        "assigned",
        "in_progress",
        "completed",
        "rejected"
      ],
      "default": "not_assigned"
    },
    "consent_verbal": {
      "type": "boolean",
      "default": false
    },
    "consent_verbal_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "consent_verbal_agent": {
      "type": "string"
    },
    "consent_verbal_gps": {
      "type": "string"
    },
    "consent_audio_captured": {
      "type": "boolean",
      "default": false
    },
    "consent_audio_declined": {
      "type": "boolean",
      "default": false
    },
    "consent_signature_captured": {
      "type": "boolean",
      "default": false
    },
    "consent_signature_declined": {
      "type": "boolean",
      "default": false
    },
    "consent_photo_captured": {
      "type": "boolean",
      "default": false
    },
    "consent_photo_declined": {
      "type": "boolean",
      "default": false
    },
    "consent_witness_name": {
      "type": "string"
    },
    "consent_witness_phone": {
      "type": "string"
    },
    "consent_witness_role": {
      "type": "string",
      "enum": [
        "family_witness",
        "community_witness",
        "village_head",
        "kindred_head",
        "none"
      ]
    },
    "consent_strength_score": {
      "type": "number"
    },
    "consent_confidence": {
      "type": "string",
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ]
    },
    "consent_timeline": {
      "type": "string",
      "description": "IMMUTABLE JSON array of consent events"
    },
    "community_confirmed": {
      "type": "boolean",
      "default": false
    },
    "community_confirmed_by": {
      "type": "string"
    },
    "community_confirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_sealed": {
      "type": "boolean",
      "default": false,
      "description": "PHASE 3 \u2014 Evidence package sealed"
    },
    "evidence_seal_id": {
      "type": "string"
    },
    "evidence_seal_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_sealed_by": {
      "type": "string"
    },
    "evidence_seal_hash": {
      "type": "string",
      "description": "SHA-256 of all evidence fingerprints"
    },
    "evidence_count_at_seal": {
      "type": "number"
    },
    "qr_code_url": {
      "type": "string"
    },
    "certificate_a_url": {
      "type": "string"
    },
    "certificate_b_url": {
      "type": "string"
    },
    "certificate_c_url": {
      "type": "string"
    },
    "certificate_status": {
      "type": "string",
      "enum": [
        "PENDING",
        "HELD",
        "ACTIVE",
        "RELEASED"
      ],
      "default": "PENDING"
    },
    "certificate_hold_reason": {
      "type": "string"
    },
    "protected_in_registry": {
      "type": "boolean",
      "default": true
    },
    "amount_paid": {
      "type": "number",
      "default": 0
    },
    "total_fee": {
      "type": "number"
    },
    "outstanding_balance": {
      "type": "number"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "PAID",
        "PARTIALLY_PAID",
        "HELD",
        "UNPAID"
      ],
      "default": "UNPAID"
    },
    "payment_history": {
      "type": "string"
    },
    "field_agent_email": {
      "type": "string"
    },
    "field_agent_name": {
      "type": "string"
    },
    "community_validation_status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "rejected",
        "clarification_requested"
      ],
      "default": "pending"
    },
    "community_validator_name": {
      "type": "string"
    },
    "community_validator_notes": {
      "type": "string"
    },
    "community_validation_date": {
      "type": "string",
      "format": "date-time"
    },
    "validation_timeline": {
      "type": "string",
      "description": "PHASE 7 \u2014 JSON array of validation events"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supporting_docs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "registered_by": {
      "type": "string"
    },
    "device_id": {
      "type": "string"
    },
    "is_offline_created": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "community",
    "ward",
    "lga",
    "state",
    "ownership_type"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.field_agent_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "super_admin",
                "surveyor_general",
                "compliance_officer",
                "licensed_surveyor",
                "surveyor_partner",
                "community_validator",
                "government_observer"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}",
          "data.status": {
            "$nin": [
              "certificate_issued"
            ]
          },
          "data.evidence_sealed": {
            "$ne": true
          }
        },
        {
          "data.field_agent_email": "{{user.email}}",
          "data.status": {
            "$nin": [
              "certificate_issued"
            ]
          },
          "data.evidence_sealed": {
            "$ne": true
          }
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "super_admin",
                "surveyor_general",
                "compliance_officer"
              ]
            }
          }
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "licensed_surveyor",
                "surveyor_partner"
              ]
            },
            "data.survey_status": {
              "$in": [
                "assigned",
                "in_progress"
              ]
            }
          }
        },
        {
          "user_condition": {
            "role": "community_validator"
          },
          "data.community_validation_status": "pending"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}