{
  "name": "InstitutionPlan",
  "type": "object",
  "description": "Recurring institutional access plans for banks, law firms, survey firms, local governments, developers, and insurers.",
  "properties": {
    "plan_id": {
      "type": "string"
    },
    "plan_name": {
      "type": "string"
    },
    "plan_code": {
      "type": "string"
    },
    "plan_type": {
      "type": "string",
      "enum": [
        "BANK",
        "LAW_FIRM",
        "SURVEY_FIRM",
        "LOCAL_GOVERNMENT",
        "DEVELOPER",
        "INSURANCE_PROVIDER"
      ]
    },
    "monthly_fee": {
      "type": "number",
      "default": 0
    },
    "included_credits": {
      "type": "number",
      "default": 0
    },
    "overage_rate": {
      "type": "number",
      "default": 0
    },
    "api_access": {
      "type": "boolean",
      "default": false
    },
    "report_access": {
      "type": "boolean",
      "default": false
    },
    "priority_processing": {
      "type": "boolean",
      "default": false
    },
    "max_users": {
      "type": "number",
      "default": 5
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "INACTIVE",
        "DRAFT"
      ],
      "default": "ACTIVE"
    }
  },
  "required": [
    "plan_name",
    "plan_code",
    "plan_type",
    "monthly_fee"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "super_admin",
            "surveyor_general",
            "compliance_officer"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}