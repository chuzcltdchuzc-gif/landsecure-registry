{
  "name": "ServiceRequest",
  "type": "object",
  "description": "Customer-initiated service request. Creates background jobs, consumes credits, generates ledger entries.",
  "properties": {
    "request_id": {
      "type": "string"
    },
    "request_reference": {
      "type": "string"
    },
    "requestor": {
      "type": "string"
    },
    "requestor_id": {
      "type": "string"
    },
    "service_id": {
      "type": "string"
    },
    "service_name": {
      "type": "string"
    },
    "service_category": {
      "type": "string"
    },
    "parcel_id": {
      "type": "string"
    },
    "parcel_number": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "SUBMITTED",
        "UNDER_REVIEW",
        "PROCESSING",
        "COMPLETED",
        "DELIVERED",
        "CANCELLED"
      ],
      "default": "SUBMITTED"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "assigned_to": {
      "type": "string"
    },
    "job_reference": {
      "type": "string"
    },
    "invoice_reference": {
      "type": "string"
    },
    "delivery_reference": {
      "type": "string"
    },
    "credits_consumed": {
      "type": "number",
      "default": 0
    },
    "cash_amount": {
      "type": "number",
      "default": 0
    },
    "priority": {
      "type": "string",
      "enum": [
        "STANDARD",
        "PRIORITY",
        "URGENT"
      ],
      "default": "STANDARD"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "requestor",
    "service_id"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {},
    "update": {},
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}