{
  "name": "Dispute",
  "type": "object",
  "properties": {
    "parcel_id": {
      "type": "string",
      "description": "Related land parcel ID"
    },
    "parcel_number": {
      "type": "string",
      "description": "Parcel number"
    },
    "complainant_email": {
      "type": "string",
      "description": "Person filing the dispute"
    },
    "complainant_name": {
      "type": "string",
      "description": "Complainant full name"
    },
    "dispute_type": {
      "type": "string",
      "enum": [
        "boundary",
        "ownership",
        "fraud",
        "encroachment",
        "documentation",
        "other"
      ],
      "description": "Type of dispute"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the dispute"
    },
    "evidence_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Supporting evidence file URLs"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "under_review",
        "resolved",
        "escalated",
        "closed"
      ],
      "default": "open"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "assigned_to": {
      "type": "string",
      "description": "Officer assigned to handle"
    },
    "resolution_notes": {
      "type": "string"
    },
    "resolved_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "parcel_id",
    "complainant_name",
    "dispute_type",
    "description"
  ]
}