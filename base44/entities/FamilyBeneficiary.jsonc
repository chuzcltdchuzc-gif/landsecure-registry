{
  "name": "FamilyBeneficiary",
  "type": "object",
  "properties": {
    "family_ownership_id": {
      "type": "string",
      "description": "Reference to FamilyOwnership ID"
    },
    "parcel_id": {
      "type": "string"
    },
    "parcel_number": {
      "type": "string"
    },
    "parent_beneficiary_id": {
      "type": "string",
      "description": "ID of parent beneficiary (for successor chains)"
    },
    "inheritance_rank": {
      "type": "number",
      "description": "Priority rank (1 = highest)"
    },
    "generation_level": {
      "type": "number",
      "description": "Generation level from family head"
    },
    "family_branch": {
      "type": "string",
      "description": "Which branch of the family"
    },
    "full_name": {
      "type": "string"
    },
    "relationship": {
      "type": "string",
      "enum": [
        "son",
        "daughter",
        "grandson",
        "granddaughter",
        "nephew",
        "niece",
        "brother",
        "sister",
        "cousin",
        "spouse",
        "other"
      ]
    },
    "percentage_share": {
      "type": "number",
      "description": "Ownership percentage (0-100)"
    },
    "allocated_plot": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "deceased",
        "missing",
        "transferred",
        "disputed",
        "under_verification",
        "minor"
      ],
      "default": "active"
    },
    "date_added": {
      "type": "string",
      "format": "date"
    },
    "date_of_death": {
      "type": "string",
      "format": "date"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "unverified",
        "pending",
        "verified",
        "rejected"
      ],
      "default": "unverified"
    },
    "national_id": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "family_ownership_id",
    "full_name",
    "relationship",
    "percentage_share"
  ]
}