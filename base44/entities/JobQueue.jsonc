{
  "name": "JobQueue",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant scoping for job queue isolation"
    },
    "job_type": {
      "type": "string",
      "enum": [
        "fraud_scoring",
        "gis_validation",
        "pdf_generation",
        "bulk_import",
        "report_export",
        "backup",
        "duplicate_scan",
        "evidence_hashing",
        "archive_import",
        "verification_report",
        "ocr_processing",
        "qr_certificate_generation",
        "pdf_certificate_generation"
      ],
      "description": "Type of background job"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "queued",
        "processing",
        "running",
        "completed",
        "failed",
        "retrying",
        "cancelled"
      ],
      "default": "pending",
      "description": "Current job status. pending=awaiting pickup, processing=actively executing"
    },
    "payload": {
      "type": "string",
      "description": "JSON string of job input parameters"
    },
    "result": {
      "type": "string",
      "description": "JSON string of job output/result"
    },
    "error_message": {
      "type": "string",
      "description": "Error details if job failed"
    },
    "retry_count": {
      "type": "number",
      "default": 0,
      "description": "Number of retry attempts made"
    },
    "max_retries": {
      "type": "number",
      "default": 3,
      "description": "Maximum retry attempts allowed"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by_email": {
      "type": "string",
      "description": "User who enqueued the job"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "critical"
      ],
      "default": "normal"
    },
    "idempotency_key": {
      "type": "string",
      "description": "Unique key to prevent duplicate job creation for the same operation"
    },
    "progress_pct": {
      "type": "number",
      "default": 0,
      "description": "Progress percentage 0-100 for long-running jobs"
    },
    "job_id": {
      "type": "string",
      "description": "Human-readable job identifier"
    },
    "result_reference": {
      "type": "string",
      "description": "Reference to job result (parcel_id, file_uri, etc.)"
    }
  },
  "required": [
    "job_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "super_admin",
            "surveyor_general",
            "compliance_officer",
            "licensed_surveyor",
            "surveyor_partner",
            "field_agent"
          ]
        }
      }
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "super_admin",
                "surveyor_general",
                "compliance_officer",
                "licensed_surveyor",
                "surveyor_partner"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "super_admin",
            "surveyor_general",
            "compliance_officer"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}