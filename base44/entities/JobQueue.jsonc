{
  "name": "JobQueue",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant scoping for job queue isolation"
    },
    "job_type": {
      "type": "string",
      "enum": [
        "fraud_scoring",
        "gis_validation",
        "pdf_generation",
        "bulk_import",
        "report_export",
        "backup"
      ],
      "description": "Type of background job"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "completed",
        "failed",
        "retrying",
        "cancelled"
      ],
      "default": "queued",
      "description": "Current job status"
    },
    "payload": {
      "type": "string",
      "description": "JSON string of job input parameters"
    },
    "result": {
      "type": "string",
      "description": "JSON string of job output/result"
    },
    "error_message": {
      "type": "string",
      "description": "Error details if job failed"
    },
    "retry_count": {
      "type": "number",
      "default": 0,
      "description": "Number of retry attempts made"
    },
    "max_retries": {
      "type": "number",
      "default": 3,
      "description": "Maximum retry attempts allowed"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by_email": {
      "type": "string",
      "description": "User who enqueued the job"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "critical"
      ],
      "default": "normal"
    }
  },
  "required": [
    "job_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "super_admin",
            "surveyor_general",
            "compliance_officer"
          ]
        }
      }
    },
    "read": {
      "user_condition": {
        "role": {
          "$in": [
            "super_admin",
            "surveyor_general",
            "compliance_officer"
          ]
        }
      }
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "super_admin",
            "surveyor_general",
            "compliance_officer"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}