{
  "name": "CommunityReviewAlert",
  "type": "object",
  "description": "Auto-generated alert when conflicting community attestations are detected",
  "properties": {
    "alert_id": {
      "type": "string",
      "description": "Auto-generated: CRA-EHM-000001"
    },
    "parcel_id": {
      "type": "string"
    },
    "parcel_number": {
      "type": "string"
    },
    "attestation_a": {
      "type": "string",
      "description": "First conflicting attestation ID"
    },
    "attestation_b": {
      "type": "string",
      "description": "Second conflicting attestation ID"
    },
    "conflict_type": {
      "type": "string",
      "enum": [
        "STATEMENT_CONFLICT",
        "BOUNDARY_CONFLICT",
        "RELATIONSHIP_CONFLICT",
        "COMMUNITY_KNOWLEDGE_CONFLICT",
        "TRADITIONAL_ENDORSEMENT_CONFLICT"
      ]
    },
    "conflict_summary": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "OPEN",
        "UNDER_REVIEW",
        "RESOLVED",
        "DISMISSED"
      ],
      "default": "OPEN"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_by": {
      "type": "string"
    },
    "review_notes": {
      "type": "string"
    }
  },
  "required": [
    "parcel_id",
    "conflict_type"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "user_condition": {
        "role": {
          "$in": [
            "super_admin",
            "surveyor_general",
            "compliance_officer",
            "surveyor_partner",
            "licensed_surveyor"
          ]
        }
      }
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "super_admin",
            "surveyor_general",
            "compliance_officer"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}