{
  "name": "EconomicAuditEntry",
  "type": "object",
  "description": "Immutable audit trail for every economic event. Never modified. Never deleted.",
  "properties": {
    "audit_id": {
      "type": "string"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "CREDIT_AUTHORIZED",
        "CREDIT_RESERVED",
        "CREDIT_CONSUMED",
        "CREDIT_REFUNDED",
        "CREDIT_TRANSFERRED",
        "CREDIT_GRANTED",
        "CREDIT_PURCHASED",
        "WALLET_CREATED",
        "WALLET_FROZEN",
        "WALLET_UNFROZEN",
        "SERVICE_BILLED",
        "SERVICE_COMPLETED",
        "SERVICE_REFUNDED",
        "INVOICE_GENERATED",
        "INVOICE_PAID",
        "INVOICE_CANCELLED",
        "FRAUD_DETECTED",
        "QUOTA_EXCEEDED",
        "OVERAGE_CHARGED"
      ]
    },
    "entity_type": {
      "type": "string"
    },
    "entity_id": {
      "type": "string"
    },
    "actor_email": {
      "type": "string"
    },
    "actor_id": {
      "type": "string"
    },
    "before_state": {
      "type": "string"
    },
    "after_state": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "reference": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "ip_address": {
      "type": "string"
    },
    "device_info": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "action_type",
    "entity_type",
    "actor_email"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "super_admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}