{
  "name": "CreditWallet",
  "type": "object",
  "description": "Platform credit wallet per user. All monetized activities consume credits.",
  "properties": {
    "wallet_id": {
      "type": "string",
      "description": "Auto-generated: WAL-EHM-000001"
    },
    "user_id": {
      "type": "string",
      "description": "Linked user account ID"
    },
    "user_email": {
      "type": "string"
    },
    "credit_balance": {
      "type": "number",
      "default": 0
    },
    "reserved_credits": {
      "type": "number",
      "default": 0
    },
    "credits_consumed": {
      "type": "number",
      "default": 0
    },
    "credits_purchased": {
      "type": "number",
      "default": 0
    },
    "credits_granted": {
      "type": "number",
      "default": 0
    },
    "wallet_status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "SUSPENDED",
        "FROZEN",
        "CLOSED"
      ],
      "default": "ACTIVE"
    },
    "frozen_reason": {
      "type": "string"
    },
    "frozen_at": {
      "type": "string",
      "format": "date-time"
    },
    "frozen_by": {
      "type": "string"
    },
    "organization_wallet_id": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "user_email"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {},
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "super_admin",
                "surveyor_general",
                "compliance_officer"
              ]
            }
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}