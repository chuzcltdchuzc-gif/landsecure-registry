{
  "name": "Invoice",
  "type": "object",
  "description": "Automated invoice generation for all monetized service deliveries. Supports PDF generation via background jobs.",
  "properties": {
    "invoice_id": {
      "type": "string",
      "description": "Auto-generated ID"
    },
    "invoice_number": {
      "type": "string",
      "description": "Auto-generated: INV-EHM-000001"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "service_request": {
      "type": "string",
      "description": "Linked ServiceRequest reference"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "tax": {
      "type": "number",
      "default": 0,
      "description": "VAT/tax amount"
    },
    "total_amount": {
      "type": "number",
      "default": 0
    },
    "currency": {
      "type": "string",
      "default": "NGN"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "ISSUED",
        "PAID",
        "OVERDUE",
        "CANCELLED"
      ],
      "default": "DRAFT"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "invoice_url": {
      "type": "string",
      "description": "URL to downloadable PDF invoice"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "customer_id",
    "amount",
    "total_amount"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "super_admin",
                "surveyor_general",
                "compliance_officer"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "super_admin",
            "surveyor_general",
            "compliance_officer"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}