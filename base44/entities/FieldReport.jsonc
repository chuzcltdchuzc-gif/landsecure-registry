{
  "name": "FieldReport",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant identifier (LGA code). Enforces multi-tenant isolation."
    },
    "parcel_id": {
      "type": "string"
    },
    "parcel_number": {
      "type": "string"
    },
    "agent_email": {
      "type": "string"
    },
    "agent_name": {
      "type": "string"
    },
    "report_type": {
      "type": "string",
      "enum": [
        "boundary_check",
        "photo_capture",
        "gps_survey",
        "drone_survey",
        "site_inspection",
        "verification"
      ]
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "gps_accuracy": {
      "type": "number",
      "description": "GPS accuracy in meters (lower is better)"
    },
    "capture_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Exact device capture time"
    },
    "device_identifier": {
      "type": "string",
      "description": "Device ID or model"
    },
    "network_status": {
      "type": "string",
      "enum": [
        "online",
        "offline",
        "synced_offline"
      ],
      "default": "online"
    },
    "capture_method": {
      "type": "string",
      "enum": [
        "manual_entry",
        "gps_auto",
        "imported"
      ],
      "default": "manual_entry"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "type": "string"
    },
    "boundary_valid": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "reviewed",
        "flagged"
      ],
      "default": "draft"
    },
    "quality_flag": {
      "type": "string",
      "enum": [
        "pass",
        "warn",
        "fail"
      ],
      "default": "pass",
      "description": "Automated quality check result"
    },
    "quality_notes": {
      "type": "string",
      "description": "Automated quality check notes"
    }
  },
  "required": [
    "parcel_id",
    "report_type",
    "description"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}",
      "user_condition": {
        "role": "field_agent"
      }
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "super_admin",
                "surveyor_general",
                "compliance_officer"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}",
          "data.status": "draft"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "super_admin",
                "surveyor_general",
                "compliance_officer"
              ]
            }
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}