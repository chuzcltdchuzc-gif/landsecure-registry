{
  "name": "OrganizationWallet",
  "type": "object",
  "description": "Institutional shared wallet for banks, law firms, survey firms, LGAs, developers.",
  "properties": {
    "wallet_id": {
      "type": "string"
    },
    "organization_name": {
      "type": "string"
    },
    "organization_type": {
      "type": "string",
      "enum": [
        "BANK",
        "LAW_FIRM",
        "SURVEY_FIRM",
        "LOCAL_GOVERNMENT",
        "DEVELOPER",
        "INSURANCE_PROVIDER"
      ]
    },
    "plan_id": {
      "type": "string"
    },
    "plan_code": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "credit_balance": {
      "type": "number",
      "default": 0
    },
    "reserved_credits": {
      "type": "number",
      "default": 0
    },
    "credits_consumed": {
      "type": "number",
      "default": 0
    },
    "credits_purchased": {
      "type": "number",
      "default": 0
    },
    "monthly_allocation": {
      "type": "number",
      "default": 0
    },
    "allocation_remaining": {
      "type": "number",
      "default": 0
    },
    "overage_credits": {
      "type": "number",
      "default": 0
    },
    "overage_cost": {
      "type": "number",
      "default": 0
    },
    "department_allocations": {
      "type": "string"
    },
    "wallet_status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "SUSPENDED",
        "FROZEN",
        "CLOSED"
      ],
      "default": "ACTIVE"
    },
    "frozen_reason": {
      "type": "string"
    },
    "frozen_at": {
      "type": "string",
      "format": "date-time"
    },
    "frozen_by": {
      "type": "string"
    },
    "billing_cycle_start": {
      "type": "string",
      "format": "date"
    },
    "billing_cycle_end": {
      "type": "string",
      "format": "date"
    },
    "member_emails": {
      "type": "string"
    }
  },
  "required": [
    "organization_name",
    "organization_type",
    "contact_email"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {},
    "update": {},
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}