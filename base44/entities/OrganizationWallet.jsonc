{
  "name": "OrganizationWallet",
  "type": "object",
  "description": "Institutional shared wallet. Banks, law firms, survey firms, LGAs, developers pool credits here. Department budgets tracked via department_allocations JSON.",
  "properties": {
    "wallet_id": {
      "type": "string",
      "description": "Auto-generated: OWL-EHM-000001"
    },
    "organization_name": {
      "type": "string"
    },
    "organization_type": {
      "type": "string",
      "enum": [
        "BANK",
        "LAW_FIRM",
        "SURVEY_FIRM",
        "LOCAL_GOVERNMENT",
        "DEVELOPER",
        "INSURANCE_PROVIDER"
      ]
    },
    "plan_id": {
      "type": "string",
      "description": "Linked InstitutionPlan ID"
    },
    "plan_code": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "credit_balance": {
      "type": "number",
      "default": 0
    },
    "reserved_credits": {
      "type": "number",
      "default": 0
    },
    "credits_consumed": {
      "type": "number",
      "default": 0
    },
    "credits_purchased": {
      "type": "number",
      "default": 0
    },
    "monthly_allocation": {
      "type": "number",
      "default": 0,
      "description": "Monthly credit allocation from plan"
    },
    "allocation_remaining": {
      "type": "number",
      "default": 0,
      "description": "Credits remaining in current billing cycle"
    },
    "overage_credits": {
      "type": "number",
      "default": 0,
      "description": "Credits consumed beyond monthly allocation"
    },
    "overage_cost": {
      "type": "number",
      "default": 0,
      "description": "Total overage cost in NGN"
    },
    "department_allocations": {
      "type": "string",
      "description": "JSON array: [{dept, budget, used, remaining}]"
    },
    "wallet_status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "SUSPENDED",
        "FROZEN",
        "CLOSED"
      ],
      "default": "ACTIVE"
    },
    "frozen_reason": {
      "type": "string"
    },
    "frozen_at": {
      "type": "string",
      "format": "date-time"
    },
    "frozen_by": {
      "type": "string"
    },
    "billing_cycle_start": {
      "type": "string",
      "format": "date"
    },
    "billing_cycle_end": {
      "type": "string",
      "format": "date"
    },
    "member_emails": {
      "type": "string",
      "description": "JSON array of authorized member emails"
    }
  },
  "required": [
    "organization_name",
    "organization_type",
    "contact_email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "super_admin",
            "surveyor_general",
            "compliance_officer"
          ]
        }
      }
    },
    "read": {
      "$or": [
        {
          "data.contact_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "super_admin",
                "surveyor_general",
                "compliance_officer"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "super_admin",
            "surveyor_general",
            "compliance_officer"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}