{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "general_user",
        "surveyor_general",
        "surveyor",
        "field_agent",
        "super_admin",
        "compliance_officer"
      ],
      "default": "general_user",
      "description": "User role in the system"
    },
    "role_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has explicitly selected their role during onboarding"
    },
    "account_status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "pending"
      ],
      "default": "active",
      "description": "Account status \u2014 use account_status consistently, never the field 'status'"
    },
    "suspension_reason": {
      "type": "string",
      "description": "Reason for account suspension"
    },
    "suspended_by": {
      "type": "string",
      "description": "Email of admin who suspended the account"
    },
    "suspended_at": {
      "type": "string",
      "format": "date-time"
    },
    "phone": {
      "type": "string"
    },
    "organization": {
      "type": "string"
    },
    "license_number": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    }
  },
  "required": []
}