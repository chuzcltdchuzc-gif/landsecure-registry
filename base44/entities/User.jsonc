{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "general_user",
        "surveyor_general",
        "surveyor",
        "field_agent",
        "super_admin",
        "compliance_officer",
        "licensed_surveyor",
        "surveyor_partner",
        "community_validator",
        "government_observer"
      ],
      "default": "general_user",
      "description": "User role in the system"
    },
    "role_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has explicitly selected their role during onboarding"
    },
    "account_status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "pending"
      ],
      "default": "active",
      "description": "Account status"
    },
    "suspension_reason": {
      "type": "string"
    },
    "suspended_by": {
      "type": "string"
    },
    "suspended_at": {
      "type": "string",
      "format": "date-time"
    },
    "phone": {
      "type": "string"
    },
    "organization": {
      "type": "string"
    },
    "license_number": {
      "type": "string",
      "description": "Surveyor licence number"
    },
    "avatar_url": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string",
      "description": "Tenant/LGA identifier for multi-tenant deployments"
    },
    "lga_code": {
      "type": "string",
      "description": "LGA assignment for tenant scoping"
    }
  },
  "required": []
}